ROUTER_AI_API_KEY=your_routerai_api_key_here

# Параметры подключения к БД (креды вынесены отдельно).
DB_HOST=localhost
DB_PORT=5432
DB_USER=qa_user
DB_PASSWORD=qa_password
DB_NAME=qa_review

# Базовый URL провайдера LLM и эмбеддингов (RouterAI).
# При необходимости укажите прокси/staging/другой шлюз.
ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# Phoenix (Arize) — трассировка через OTLP/gRPC.
# PHOENIX_GRPC_PORT=4317
# Явный эндпоинт (если авто-обнаружение не подходит):
# PHOENIX_GRPC_ENDPOINT=host.docker.internal:4317

# Модели (значения по умолчанию указаны ниже, можно переопределить).
# MODEL_SENIOR=deepseek/deepseek-v4-pro-0813
# MODEL_JUNIOR=deepseek/deepseek-v4-flash-0731
# MODEL_EMBEDDING=openai/text-embedding-3-small
# EMBEDDING_DIMENSION=1536
# RAG_TOP_K=10

# Параметры генерации LLM.
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=16384
# LLM_TIMEOUT_SECONDS=60
# EMBEDDING_TIMEOUT_SECONDS=30
# LLM_RETRY_ATTEMPTS=3

# Пороги бизнес-логики агентов.
# AGENTS_CHUNK_SIZE=50
# SQL_MAX_ROWS=1000
# PRIORITY_WEIGHTS={"Critical": 3, "High": 2, "Medium": 1, "Low": 0.5}
# COVERAGE_RISK_HIGH_THRESHOLD=80.0
# COVERAGE_RISK_MEDIUM_THRESHOLD=95.0

# Стоимость токенов (USD за 1M) по моделям — JSON.
# MODEL_PRICING={"deepseek/deepseek-v4-pro-0813": {"input": 0.27, "output": 1.10}, "deepseek/deepseek-v4-flash-0731": {"input": 0.10, "output": 0.40}, "openai/text-embedding-3-small": {"input": 0.02, "output": 0.0}}
